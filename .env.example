# App
# APP_ENV is development, test or production. Set APP_ENV=production for a real
# deployment: the API then refuses to start without a unique SECRET_KEY (32+
# characters) and https:// web origins, sends the session cookie only over HTTPS,
# hides the API docs, disables the demo reset endpoint and skips the demo
# accounts. See docs/SECURITY.md for the full production checklist.
APP_ENV=development
SECRET_KEY=change-this-in-production
# One origin, or a comma-separated list, allowed to call the API from a browser.
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql+psycopg://service_desk:service_desk@db:5432/service_desk
FILE_STORAGE_PATH=/data/uploads
# Optional overrides of the APP_ENV defaults above.
# COOKIE_SECURE=true
# ENABLE_DEMO_RESET=false
# SEED_DEMO_DATA=false

# Host ports. If you change API_PORT, update NEXT_PUBLIC_API_URL to match.
# If you change WEB_PORT, update WEB_ORIGIN to match.
# If you change POSTGRES_PASSWORD, update DATABASE_URL to match. PostgreSQL reads
# it only when the database volume is first created (see docs/SECURITY.md).
# WEB_PORT=3000
# API_PORT=8000
# DB_PORT=5432
# POSTGRES_PASSWORD=service_desk

# The demo works without downloading or connecting a model.
# Use native or docker only when you want to run the optional model services.
LOCAL_RUNN=off

# AI provider: demo | openai_compatible
AI_MODE=demo
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=your-model-name
AI_PROVIDER_KIND=cloud
AI_MAX_SENSITIVITY=internal
AI_TIMEOUT_SECONDS=60

# Request check: demo uses fixed sample answers; remote uses the optional Laya service.
LAYA_MODE=demo
LAYA_BASE_URL=http://laya:8010
LAYA_MODEL=convaiinnovations/laya
LAYA_ROUTE_MODE=router
LAYA_PRELOAD=true
LAYA_MAX_LOADED=2
LAYA_SUBFOLDER=
LAYA_DEVICE=
LAYA_TIMEOUT_SECONDS=45
LAYA_REQUIRED=false

# Embeddings: demo | openai_compatible
EMBEDDING_MODE=demo
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=your-embedding-model

# Frontend (baked into the web build)
NEXT_PUBLIC_API_URL=http://localhost:8000
